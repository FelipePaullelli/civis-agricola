from pathlib import Path
from typing import Dict, Any, Union
import tempfile
import zipfile
import geopandas as gpd
import shapely
from shapely.geometry import Polygon, MultiPolygon
from shapely.validation import explain_validity, make_valid

TARGET_CRS = "EPSG:4674"  # SIRGAS 2000 Geográfico (Padrão Oficial)
METRIC_CRS = "EPSG:31983"  # SIRGAS 2000 / UTM zone 23S (Cálculo de área na Bacia PCJ)
SUPPORTED_EXTENSIONS = {".geojson", ".json", ".kml", ".shp", ".zip"}


class SpatialValidationError(Exception):
    """Exceção customizada para erros de validação geométrica ou de formato."""
    pass


def _load_geodataframe(file_input: Union[str, Path, bytes], filename: str = "") -> gpd.GeoDataFrame:
    """Carrega arquivos .geojson, .kml, .shp ou .zip em um GeoDataFrame."""
    if isinstance(file_input, (str, Path)):
        path = Path(file_input)
        ext = path.suffix.lower()
        if ext not in SUPPORTED_EXTENSIONS:
            raise SpatialValidationError(
                f"Formato '{ext}' não suportado. Envie arquivos .geojson, .kml, .shp ou .zip."
            )
        if ext == ".zip":
            return gpd.read_file(f"zip://{path}")
        return gpd.read_file(path)

    ext = Path(filename).suffix.lower()
    if ext not in SUPPORTED_EXTENSIONS:
        raise SpatialValidationError(
            f"Formato '{ext}' não suportado. Envie arquivos .geojson, .kml, .shp ou .zip."
        )

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp_path = Path(tmpdir) / f"upload{ext}"
        tmp_path.write_bytes(file_input)

        if ext == ".zip":
            with zipfile.ZipFile(tmp_path, "r") as zf:
                zf.extractall(tmpdir)
            shp_files = list(Path(tmpdir).rglob("*.shp"))
            if not shp_files:
                raise SpatialValidationError("O arquivo .zip enviado não contém nenhum arquivo .shp.")
            return gpd.read_file(shp_files[0])

        return gpd.read_file(tmp_path)


def validate_and_standardize(
    file_input: Union[str, Path, bytes],
    filename: str = "",
) -> Dict[str, Any]:
    """
    Valida se o arquivo contém um polígono fechado válido e reprojeta para SIRGAS 2000 (EPSG:4674).
    Retorna o GeoDataFrame padronizado e os metadados geométricos da propriedade.
    """
    try:
        gdf = _load_geodataframe(file_input, filename=filename)
    except SpatialValidationError:
        raise
    except Exception as exc:
        raise SpatialValidationError(f"Falha ao ler o arquivo espacial: {exc}") from exc

    if gdf.empty or gdf.geometry.isna().all():
        raise SpatialValidationError("O arquivo enviado não contém nenhuma geometria válida.")

    gdf = gdf.dropna(subset=["geometry"]).copy()
    gdf["geometry"] = shapely.force_2d(gdf["geometry"])

    tipos_encontrados = set(gdf.geometry.geom_type.unique())
    tipos_permitidos = {"Polygon", "MultiPolygon"}
    if not tipos_encontrados.issubset(tipos_permitidos):
        raise SpatialValidationError(
            f"Geometria inválida: esperado Polígono fechado, mas foi encontrado {tipos_encontrados}."
        )

    if not gdf.geometry.is_valid.all():
        gdf["geometry"] = gdf["geometry"].apply(lambda geom: make_valid(geom) if not geom.is_valid else geom)
        gdf = gdf.explode(index_parts=False).reset_index(drop=True)
        gdf = gdf[gdf.geometry.geom_type.isin(tipos_permitidos)].copy()

    if gdf.empty or not gdf.geometry.is_valid.all():
        motivos = [explain_validity(g) for g in gdf.geometry if not g.is_valid]
        raise SpatialValidationError(f"O polígono apresenta erros topológicos irreversíveis: {motivos}")

    crs_original = gdf.crs.to_string() if gdf.crs else "Não definido (Assumido EPSG:4674)"
    if gdf.crs is None:
        gdf = gdf.set_crs(TARGET_CRS)
    elif gdf.crs.to_epsg() != 4674:
        gdf = gdf.to_crs(TARGET_CRS)

    poligono_unificado = shapely.ops.unary_union(gdf.geometry)
    if not isinstance(poligono_unificado, (Polygon, MultiPolygon)) or poligono_unificado.is_empty:
        raise SpatialValidationError("A consolidação da geometria não resultou em um polígono fechado válido.")

    gdf_padronizado = gpd.GeoDataFrame(
        [{"id_imovel": 1, "crs_original": crs_original, "geometry": poligono_unificado}],
        crs=TARGET_CRS,
    )

    gdf_metrico = gdf_padronizado.to_crs(METRIC_CRS)
    area_ha = float(gdf_metrico.geometry.area.iloc[0] / 10_000.0)
    perimetro_m = float(gdf_metrico.geometry.length.iloc[0])

    if area_ha <= 0.001:
        raise SpatialValidationError("O polígono enviado possui área nula ou insignificante (< 10 m²).")

    gdf_padronizado["area_ha"] = round(area_ha, 4)
    gdf_padronizado["perimetro_m"] = round(perimetro_m, 2)

    centroide = gdf_padronizado.geometry.iloc[0].centroid

    return {
        "valido": True,
        "crs_original": crs_original,
        "crs_padronizado": TARGET_CRS,
        "area_ha": round(area_ha, 4),
        "perimetro_m": round(perimetro_m, 2),
        "centroide_lat_lon": (round(centroide.y, 6), round(centroide.x, 6)),
        "gdf": gdf_padronizado,
    }


if __name__ == "__main__":
    base_dir = Path(__file__).resolve().parent.parent
    sample_path = base_dir / "data" / "processed" / "amostra_propriedade_pcj.geojson"
    sample_path.parent.mkdir(parents=True, exist_ok=True)

    poligono_teste = Polygon([
        (-47.6520, -22.7180),
        (-47.6440, -22.7180),
        (-47.6440, -22.7120),
        (-47.6520, -22.7120),
        (-47.6520, -22.7180),
    ])
    gdf_sample = gpd.GeoDataFrame([{"nome": "Sítio São José (Teste PCJ)", "geometry": poligono_teste}], crs="EPSG:4326")
    gdf_sample.to_file(sample_path, driver="GeoJSON")

    resultado = validate_and_standardize(sample_path)
    print("=== Teste do Validador Espacial (Dia 3) ===")
    print(f"Status Válido    : {resultado['valido']}")
    print(f"CRS Original     : {resultado['crs_original']}")
    print(f"CRS Padronizado  : {resultado['crs_padronizado']}")
    print(f"Área Calculada   : {resultado['area_ha']} ha")
    print(f"Perímetro        : {resultado['perimetro_m']} m")
    print(f"Centroide (Y, X) : {resultado['centroide_lat_lon']}")
